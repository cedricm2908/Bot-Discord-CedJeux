# Variables d'environnement pour l'environnement de TEST de la V2 (Farm2Win / Bot-Discord-CedJeux).
#
# REGLES (voir consignes de securite validees) :
# - Ce fichier est un GABARIT : aucune vraie valeur ici, seulement des exemples/placeholders.
# - Copier ce fichier en ".env" (ignore par Git) dans ce meme dossier, puis remplir les vraies valeurs de TEST.
# - Ne jamais coller ici le token Discord de PRODUCTION, ni le DATABASE_URL de PRODUCTION.
# - Utiliser une application Discord separee (bot de test) et une base PostgreSQL separee de la prod.

# --- Discord (application de TEST, jamais celle de production) ---
DISCORD_TOKEN=coller_ici_le_token_du_bot_de_test
DISCORD_CLIENT_ID=coller_ici_le_client_id_de_l_app_de_test
DISCORD_CLIENT_SECRET=coller_ici_le_client_secret_de_l_app_de_test

# --- PostgreSQL (base de TEST, jamais celle de production) ---
DATABASE_URL=postgresql://user:password@host:5432/farm2win_test

# --- Serveur HTTP (Activity) ---
PORT=5000
NODE_ENV=development

# --- Logs (optionnel) ---
LOG_LEVEL=info
